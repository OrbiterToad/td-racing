{
  "name": "td-racing",
  "version": "1.0.0",
  "private": true,
  "description": "APEX / The Circuit Collection",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint \"*.{js,cjs,mjs}\" src tools tests --max-warnings 0",
    "test": "node verify.mjs && node --test tests/collisions.test.mjs",
    "test:browser": "playwright test",
    "build": "node tools/build-site.cjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "type": "module"
}
